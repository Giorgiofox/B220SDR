# Copy to .env and edit. All values are optional.

# Host port for the web UI.
NOVASDR_PORT=9002

# Host interface to bind. Use 127.0.0.1 to keep the UI local to this machine.
NOVASDR_BIND=0.0.0.0

# Cargo features for the NovaSDR build.
#   soapysdr         hardware input (required)
#   soapysdr,clfft   add OpenCL FFT, needs an OpenCL ICD in the runtime image
#   soapysdr,vkfft   add Vulkan FFT, Linux only, needs a Vulkan stack
NOVASDR_FEATURES=soapysdr

# NovaSDR commit to build. Pinned for reproducibility, bump deliberately.
NOVASDR_REF=45b2951b5771ada2399deb3f6b3ed43c946840ba

# Container memory limit. Raise it if you run rx2 with a large fft_size.
NOVASDR_MEM_LIMIT=4G

# Log verbosity: error, warn, info, debug, trace
RUST_LOG=info

# UHD receive buffer size in bytes. 0 lets UHD choose.
# Raise it if the logs fill with overflow markers at high sample rates.
UHD_RX_BUFF_SIZE=0
